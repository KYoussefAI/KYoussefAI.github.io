---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import '../styles/about.css';
---
<BaseLayout title="About" description="Youssef Khaloufi, based in Tangier, Morocco. A statistics and data science foundation, a focus on data engineering, and a belief in learning through practice.">
  <section class="about-first-screen wrap" aria-labelledby="about-title">
    <header class="about-intro" data-reveal><p class="eyebrow">04 / ABOUT</p><h1 id="about-title">Youssef Khaloufi<span class="accent">.</span></h1><p>{site.title} <span class="about-location">/ {site.location}</span></p></header>
    <div class="about-grid about-page-grid" data-reveal><Portrait /><div class="about-copy"><p class="eyebrow">THE PRINCIPLE BEHIND THE WORK</p><h2 id="philosophy-title">Understanding comes<br />from <span class="accent">building.</span></h2><p class="lead">I learn engineering by building systems and understanding the decisions behind them.</p><p>My foundation is in statistics and data science. My first personal data pipeline led me into Big Data and streaming, then into layered architecture, data quality, and analytical modelling.</p><p>I’m a {site.academicStatus.charAt(0).toLowerCase() + site.academicStatus.slice(1)} at the {site.institution}. My direction is data engineering, with applied AI as a complementary background.</p><a class="text-link" href="/background/">Education & technical background <Arrow /></a></div></div>
  </section>
  <section class="about-languages wrap" aria-labelledby="languages-title"><div class="languages"><h2 id="languages-title">Languages</h2><dl><div><dt>Arabic</dt><dd>Native</dd></div><div><dt>English</dt><dd>C1</dd></div><div><dt>French</dt><dd>B2</dd></div></dl></div></section>
  {site.beyondEngineering.enabled && site.beyondEngineering.paragraphs.length > 0 && <section class="beyond-engineering wrap"><h2>{site.beyondEngineering.title}</h2>{site.beyondEngineering.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>}
  <aside class="page-crosslink wrap"><p>The clearest way to understand my approach is through the work.</p><a class="text-link" href="/work/">Explore the projects <Arrow /></a></aside>
</BaseLayout>
